{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Equipment effects",
  "description": "Ordered equipment effects. Each object contains only kind and, where applicable, an optional integer value. Timing and other mechanics are engine presets.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/EquipmentEffect"
  },
  "$defs": {
    "EquipmentEffect": {
      "oneOf": [
        {
          "type": "object",
          "description": "This module must be targeted first. Good for defensive systems like armor.",
          "properties": {
            "kind": {
              "const": "TargetPriority"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Increases crit odds by adding an additional critical die face shipwide. Repeat for multiple faces.",
          "properties": {
            "kind": {
              "const": "CriticalFaces"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Criticals happen at max dice face. This module adds additional criticals relative to the maximum.",
          "properties": {
            "kind": {
              "const": "CriticalMaxOffset"
            },
            "value": {
              "type": "integer",
              "minimum": -20,
              "maximum": -1,
              "default": -1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Targeting modifier: choose the lowest-defense enemy system, once per round.",
          "properties": {
            "kind": {
              "const": "TargetLowestDefense"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "One substitution die at round start; value is its number of sides. Repeat for more dice.",
          "properties": {
            "kind": {
              "const": "GrantSubstitution"
            },
            "value": {
              "type": "integer",
              "minimum": 4,
              "maximum": 20,
              "default": 6
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "One substitution using the current attack die size, after seeing a roll, once per round.",
          "properties": {
            "kind": {
              "const": "SubstituteAfterRoll"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "One substitution on this weapon's failed hit, once per round.",
          "properties": {
            "kind": {
              "const": "SubstituteFailedHit"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "One substitution on this weapon's undodged failed hit, once per shot.",
          "properties": {
            "kind": {
              "const": "SubstituteUndodgedFailedHit"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Shield amount, latched at round start while powered. Shields protect all modules.",
          "properties": {
            "kind": {
              "const": "Shield"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 2
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Shield amount, latched at round start while connected; no power spend required.",
          "properties": {
            "kind": {
              "const": "ConnectedShield"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 2
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Disable one own system when the final shot total equals value. Repeat for multiple totals. Good for high-risk, high-reward weapons.",
          "properties": {
            "kind": {
              "const": "SelfDamage"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 6
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "This weapon ignores shields. Use sparingly.",
          "properties": {
            "kind": {
              "const": "IgnoreShields"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Dodge charges granted at round start while powered. Good for thruster systems.",
          "properties": {
            "kind": {
              "const": "Dodge"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 2
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Generate value Green fuel tokens on a successful round-start roll (d6 on 4-6), independent of equipment affinity. Generally 1.",
          "properties": {
            "kind": {
              "const": "GenerateGreenFuel"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Generate value Blue fuel tokens on a successful round-start roll (d8 on 5-8), independent of equipment affinity. Generally 1.",
          "properties": {
            "kind": {
              "const": "GenerateBlueFuel"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Generate value Yellow fuel tokens on a successful round-start roll (d4 on 2), independent of equipment affinity. Generally 1.",
          "properties": {
            "kind": {
              "const": "GenerateYellowFuel"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Generate value Red fuel tokens on a successful round-start roll (d6 on 4-6), independent of equipment affinity. Generally 1.",
          "properties": {
            "kind": {
              "const": "GenerateRedFuel"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Once per round, convert one selected fuel token into one Red token.",
          "properties": {
            "kind": {
              "const": "ConvertFuel"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Power tokens gained on activation; accumulated tokens attack all enemy systems. DM: DO NOT USE.",
          "properties": {
            "kind": {
              "const": "StackingAreaDamage"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Each enemy system rolls d6 on activation; rolls below value suppress it for this round. DM: DO NOT USE.",
          "properties": {
            "kind": {
              "const": "ActivationCheck"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 4
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Enemy turns skipped after critical damage. DM: DO NOT USE.",
          "properties": {
            "kind": {
              "const": "SkipTurn"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Excess shot total continues through the next automatic target.",
          "properties": {
            "kind": {
              "const": "Penetration"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "This weapon ignores dodge abilities. Use sparingly. ",
          "properties": {
            "kind": {
              "const": "IgnoreDodge"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Enemy dodge charges removed on activation.",
          "properties": {
            "kind": {
              "const": "RemoveDodge"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Maximum adjacent systems hit with half shot damage, ignoring shields, after a system is destroyed.",
          "properties": {
            "kind": {
              "const": "Splash"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 2
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Own damaged systems repaired on activation.",
          "properties": {
            "kind": {
              "const": "Repair"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Allow tunnelling (travel between numerically similar star systems) while connected and functional.",
          "properties": {
            "kind": {
              "const": "EnableTunnelling"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Additional cargo units while connected and functional. Reasonable range: 5-50",
          "properties": {
            "kind": {
              "const": "CargoCapacity"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 5
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Additional passenger berths while connected and functional. Reasonable range: 1-10",
          "properties": {
            "kind": {
              "const": "PassengerBerths"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 4
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Additional concealed cargo units while connected and functional - for smuggling. Reasonable range: 1-10. ",
          "properties": {
            "kind": {
              "const": "ConcealedCargo"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 5
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Additional capacity for each fuel color while connected and functional.",
          "properties": {
            "kind": {
              "const": "FuelCapacity"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 5
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
